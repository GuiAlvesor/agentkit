{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/agentkit_guardrail.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.*)",
      "Write(.env.*)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Edit(**/*.key)",
      "Write(**/*.key)",
      "Edit(**/secrets/**)",
      "Write(**/secrets/**)",
      "Edit(.git/**)",
      "Write(.git/**)"
    ]
  }
}
